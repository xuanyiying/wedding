{
  "name": "wedding-club-server",
  "version": "1.0.0",
  "description": "Wedding Club Official Website Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "mcp:start": "ts-node -r tsconfig-paths/register src/mcp/server.ts",
    "mcp:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/mcp/server.ts",
    "mcp:test": "ts-node -r tsconfig-paths/register src/mcp/test-client.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:init": "ts-node -r tsconfig-paths/register src/scripts/init-db.ts",
    "init:system-config": "ts-node -r tsconfig-paths/register src/scripts/init-system-config.ts"
  },
  "keywords": [
    "wedding",
    "club",
    "api",
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "Wedding Club Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "axios": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.13",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}