# Wedding Club - 生产环境 Nginx 配置模板
# 高性能、安全、负载均衡优化版本

# 上游服务器配置 - 使用动态解析避免启动时DNS问题
upstream api_backend {
    server ${API_SERVICE_NAME}:${API_SERVICE_PORT} max_fails=3 fail_timeout=30s;
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

upstream web_backend {
    server ${WEB_SERVICE_NAME}:${WEB_SERVICE_PORT} max_fails=3 fail_timeout=30s;
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

# 动态解析器配置 - 用于运行时DNS解析
resolver 127.0.0.11 valid=10s ipv6=off;

# HTTP主服务器
server {
    listen 80;
    server_name _;
    
    # 增加客户端超时设置，适应较慢的后端服务
    client_header_timeout 300s;
    client_body_timeout 300s;
    send_timeout 300s;
    
    # 大文件上传全局配置
    client_max_body_size 500M;
    client_body_buffer_size 32M;
    
    # 安全头配置
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: *.myqcloud.com http://${SERVER_HOST}:${MINIO_SERVICE_PORT}; font-src 'self' data:; connect-src 'self' https: *.myqcloud.com http://${SERVER_HOST}:${MINIO_SERVICE_PORT} blob:; media-src 'self' blob: https: *.myqcloud.com http://${SERVER_HOST}:${MINIO_SERVICE_PORT}; object-src 'none'; child-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' *.myqcloud.com http://${SERVER_HOST}:${MINIO_SERVICE_PORT};" always;

    # 健康检查端点 - 使用动态解析
    location /health {
        access_log off;
        set $api_upstream ${API_SERVICE_NAME}:${API_SERVICE_PORT};
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 前端健康检查端点
    location /nginx-health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # API代理 - 生产环境优化
    location /api/ {
        # 处理CORS预检请求
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin '*' always;
            add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
            add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Request-ID,X-External-Host,X-External-Proto' always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0 always;
            add_header Content-Type 'text/plain; charset=utf-8' always;
            return 204;
        }

        # 限流配置
        limit_req zone=api_limit burst=50 nodelay;
        limit_conn conn_limit 20;

        # 大文件上传优化配置
        client_max_body_size 500M;
        client_body_buffer_size 32M;
        client_body_timeout 300s;

        # 禁用请求缓冲以支持大文件流式传输
        proxy_request_buffering off;

        # 代理配置
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        
        # 添加自定义头，用于API服务识别外部访问地址
        proxy_set_header X-External-Host $host;
        proxy_set_header X-External-Proto $scheme;

        # CORS头设置
        add_header Access-Control-Allow-Origin '*' always;
        add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
        add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Request-ID' always;
        add_header Access-Control-Expose-Headers 'Content-Length,Content-Range,X-Request-ID' always;

        # 缓存配置
        proxy_cache api_cache;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 302 10m;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_cache_bypass $http_upgrade $cookie_nocache $arg_nocache;
        proxy_no_cache $http_upgrade $cookie_nocache $arg_nocache;

        # 添加缓存状态头
        add_header X-Cache-Status $upstream_cache_status;

        # 超时配置
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # 缓冲配置 - 优化大文件响应
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 32 16k;
        proxy_busy_buffers_size 32k;
        proxy_max_temp_file_size 1024m;
        proxy_temp_file_write_size 16k;
    }

    # 登录API特殊限流
    location /api/v1/auth/login {
        # 处理CORS预检请求
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin '*' always;
            add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
            add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Request-ID,X-External-Host,X-External-Proto' always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0 always;
            add_header Content-Type 'text/plain; charset=utf-8' always;
            return 204;
        }

        limit_req zone=login_limit burst=3 nodelay;
        limit_conn conn_limit 5;

        # 基本配置
        client_max_body_size 10M;
        client_body_buffer_size 1M;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        # 添加自定义头，用于API服务识别外部访问地址
        proxy_set_header X-External-Host $host;
        proxy_set_header X-External-Proto $scheme;

        # CORS头设置
        add_header Access-Control-Allow-Origin '*' always;
        add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
        add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Request-ID' always;
        add_header Access-Control-Expose-Headers 'Content-Length,Content-Range,X-Request-ID' always;

        # 禁用缓存
        proxy_no_cache 1;
        proxy_cache_bypass 1;

        # 超时配置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # 文件上传专用配置 - 优化大文件上传性能
    location /api/v1/files/upload {
        # 处理CORS预检请求
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin '*' always;
            add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
            add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Request-ID,X-External-Host,X-External-Proto' always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0 always;
            add_header Content-Type 'text/plain; charset=utf-8' always;
            return 204;
        }

        # 限流配置 - 文件上传相对宽松
        limit_req zone=api_limit burst=10 nodelay;
        limit_conn conn_limit 5;

        # 大文件上传专用配置
        client_max_body_size 500M;
        client_body_buffer_size 64M;
        client_body_timeout 900s;

        # 完全禁用请求缓冲，实现流式上传
        proxy_request_buffering off;
        proxy_buffering off;

        # 代理配置
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        
        # 添加自定义头，用于API服务识别外部访问地址
        proxy_set_header X-External-Host $host;
        proxy_set_header X-External-Proto $scheme;

        # CORS头设置
        add_header Access-Control-Allow-Origin '*' always;
        add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
        add_header Access-Control-Allow-Headers 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,X-Request-ID' always;
        add_header Access-Control-Expose-Headers 'Content-Length,Content-Range,X-Request-ID' always;

        # 禁用缓存
        proxy_no_cache 1;
        proxy_cache_bypass 1;

        # 超时配置 - 大文件上传需要更长时间
        proxy_connect_timeout 60s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
    }

    # Swagger UI 静态资源 - 解决404问题
    location /api/v1/docs/ {
        proxy_pass http://api_backend/api/v1/docs/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }

    # Swagger UI 静态资源文件 - 确保所有相关资源都能正确加载
    location ~* ^/api/v1/docs/(swagger-ui\.css|swagger-ui-bundle\.js|swagger-ui-standalone-preset\.js|swagger-ui-init\.js|favicon-.*\.png|oauth2-redirect\.html) {
        proxy_pass http://api_backend/api/v1/docs/$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }

    # 静态文件缓存 - 生产环境分层策略
    # 字体文件 - 长期缓存
    location ~* \.(woff|woff2|ttf|eot|otf)$ {
        proxy_pass http://web_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Vary "Accept-Encoding";

        # 启用静态文件缓存
        proxy_cache static_cache;
        proxy_cache_valid 200 1y;
    }

    # 图片资源 - 中期缓存
    location ~* \.(png|jpg|jpeg|gif|ico|svg|webp|avif)$ {
        proxy_pass http://web_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 6M;
        add_header Cache-Control "public";
        add_header Vary "Accept-Encoding";

        # 启用图片缓存
        proxy_cache image_cache;
        proxy_cache_valid 200 6M;
    }

    # CSS和JS文件 - 版本化缓存
    location ~* \.(css|js)$ {
        # 将请求代理到前端Web服务容器
        proxy_pass http://web_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 缓存配置
        expires 1M;
        add_header Cache-Control "public";
        add_header Vary "Accept-Encoding";
        
        # CORS头，防止跨域问题
        add_header Access-Control-Allow-Origin '*' always;
        add_header Access-Control-Allow-Methods 'GET, HEAD, OPTIONS' always;
        add_header Access-Control-Allow-Headers 'Origin, X-Requested-With, Content-Type, Accept' always;

        # 超时配置
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # 缓冲配置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # 启用静态文件缓存
        proxy_cache static_cache;
        proxy_cache_valid 200 1M;
    }

    # 其他静态资源
    location ~* \.(pdf|doc|docx|zip|tar|gz|mp4|mp3|avi)$ {
        proxy_pass http://web_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 7d;
        add_header Cache-Control "public";

        # 大文件流式传输
        proxy_max_temp_file_size 0;
        proxy_buffering off;
    }

    # SPA路由支持 - 使用动态解析
    location / {
        # 使用变量实现动态解析，避免启动时DNS问题
        set $web_upstream ${WEB_SERVICE_NAME}:${WEB_SERVICE_PORT};
        proxy_pass http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # 超时配置
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 缓冲配置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
    }

    # 安全配置 - 隐藏敏感文件
    location ~ /\. {
        deny all;
    }

    location ~ ~$ {
        deny all;
    }

    location ~* \.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$ {
        deny all;
    }

    # 错误页面 - 使用动态解析
    error_page 404 @fallback;
    error_page 500 502 503 504 @fallback;
    
    location @fallback {
        set $web_upstream ${WEB_SERVICE_NAME}:${WEB_SERVICE_PORT};
        proxy_pass http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 超时配置
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}