# =============================================================================
# # Wedding Club - Production Environment Configuration
# =============================================================================

# 环境标识
ENVIRONMENT=prod
NODE_ENV=prod

# 域名和端口配置
DOMAIN=150.158.20.143
WEB_PORT=8080
SERVER_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# OSS存储配置（统一使用OSS_前缀）
OSS_TYPE=minio
OSS_ENDPOINT=http://wedding-minio-prod:9000
OSS_PUBLIC_ENDPOINT=http://150.158.20.143:9001
OSS_ACCESS_KEY=prod_minio_admin
OSS_SECRET_KEY=prod_secure_minio_password_789
OSS_BUCKET=wedding-service
OSS_REGION=us-east-1
OSS_USE_SSL=false
OSS_PATH_STYLE=true

# MinIO服务配置（Docker Compose使用）
MINIO_ROOT_USER=prod_minio_admin
MINIO_ROOT_PASSWORD=prod_secure_minio_password_789

# 数据库配置（统一使用DB_前缀）
DB_HOST=wedding-prod
DB_PORT=3306
DB_NAME=wedding_service_prod
DB_USER=wedding_service_prod
DB_PASSWORD=prod_secure_password_789
DB_USERNAME=wedding_service_prod

# MySQL服务配置（Docker Compose使用）
MYSQL_ROOT_PASSWORD=prod_secure_root_password_789
MYSQL_DATABASE=wedding_service_prod
MYSQL_USER=wedding_service_prod
MYSQL_PASSWORD=prod_secure_password_789

# Redis配置
REDIS_HOST=wedding-redis-prod
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=prod_secure_redis_password_789

# JWT配置
JWT_SECRET=prod_ultra_secure_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=prod_ultra_secure_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 服务器配置
HOST=0.0.0.0
PORT=3000
API_HOST=150.158.20.143
SERVER_HOST=150.158.20.143

# Nginx服务配置
NGINX_PORT=80
WEB_INTERNAL_PORT=8081
SERVER_INTERNAL_PORT=3000

# Docker服务名称配置
API_SERVICE_NAME=wedding-api-prod
API_SERVICE_PORT=3000
WEB_SERVICE_NAME=wedding-web-prod
WEB_SERVICE_PORT=80
MINIO_SERVICE_NAME=wedding-minio-prod
MINIO_SERVICE_PORT=9000

# 文件上传配置
UPLOAD_MAX_SIZE=200MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,mp4,mov,avi,pdf,doc,docx

# 日志配置
LOG_LEVEL=warn
LOG_FILE_ENABLED=true

# 邮件配置（生产环境）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=noreply@wedding.com
SMTP_PASS=prod_email_password
SMTP_FROM=noreply@wedding.com

# 微信配置（生产环境）
WECHAT_APP_ID=prod_wechat_app_id
WECHAT_APP_SECRET=prod_wechat_app_secret

# 支付配置（生产环境）
PAYMENT_SANDBOX=false
ALIPAY_APP_ID=prod_alipay_app_id
ALIPAY_PRIVATE_KEY=prod_alipay_private_key

# 缓存配置
CACHE_TTL=3600
CACHE_MAX_KEYS=10000

# 安全配置
CORS_ORIGIN=http://150.158.20.143
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# SSL配置
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 监控配置
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# 前端环境变量配置
VITE_API_BASE_URL=http://150.158.20.143:3000/api/v1
VITE_APP_TITLE=婚礼主持人平台
VITE_ENVIRONMENT=production
VITE_NODE_ENV=prod

# 文件上传配置
DIRECT_UPLOAD_OSS=false
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg,video/quicktime,video/x-msvideo,video/x-ms-wmv,video/x-flv