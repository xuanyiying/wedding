# =============================================================================
# # Wedding Club - Production Environment Configuration
# =============================================================================

# 环境标识
ENVIRONMENT=prod
NODE_ENV=prod

# 域名和端口配置
DOMAIN=luhe.site
WEB_PORT=80
SERVER_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# OSS存储配置（统一使用OSS_前缀）
OSS_TYPE=tencent
OSS_REGION=${OSS_REGION:-}
OSS_ENDPOINT=${OSS_ENDPOINT:-}
OSS_PUBLIC_ENDPOINT=${OSS_PUBLIC_ENDPOINT:-}
OSS_ACCESS_KEY=${OSS_ACCESS_KEY:-}
OSS_SECRET_KEY=${OSS_SECRET_KEY:-}
OSS_BUCKET=${OSS_BUCKET:-}
OSS_USE_SSL=true

# MinIO服务配置（Docker Compose使用）
# MINIO_ROOT_USER=${MINIO_ROOT_USER:-}
# MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-}

# 数据库配置（统一使用DB_前缀）
DB_HOST=wedding-service-mysql-prod
DB_PORT=3306
DB_NAME=wedding_service
DB_USER=wedding_service
DB_PASSWORD='Wd@2026!#Pass88'
DB_USERNAME=wedding_service

# MySQL服务配置（Docker Compose使用）
MYSQL_ROOT_PASSWORD='WeddingRoot_99_!@#'
MYSQL_DATABASE=wedding_service
MYSQL_USER=wedding_service
MYSQL_PASSWORD='Wd@2026!#Pass88'

# Redis配置
REDIS_HOST=wedding-service-redis-prod
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD='RediAuth_2026_Wedding'

# JWT配置
JWT_SECRET='WeddingClub_Primary_JWT_Secret_2026_!@#$%^&*()'
JWT_REFRESH_SECRET='WeddingClub_Refresh_JWT_Secret_2026_)(*&^%$#@!'
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 服务器配置
HOST=0.0.0.0
PORT=3000
API_HOST=luhe.site
SERVER_HOST=luhe.site

# Nginx服务配置
NGINX_PORT=80
WEB_INTERNAL_PORT=8081
SERVER_INTERNAL_PORT=3000

# Docker服务名称配置
API_SERVICE_NAME=wedding-service-api-prod
API_SERVICE_PORT=3000
WEB_SERVICE_NAME=wedding-service-web-prod
WEB_SERVICE_PORT=80
REDIS_SERVICE_NAME=wedding-service-redis-prod
REDIS_SERVICE_PORT=6379
MYSQL_SERVICE_NAME=wedding-service-mysql-prod
MYSQL_SERVICE_PORT=3306
# 文件上传配置
UPLOAD_MAX_SIZE=200MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,mp4,mov,avi,pdf,doc,docx

LOG_FILE=/app/logs/app.log
LOG_ERROR_FILE=/app/logs/error.log
LOG_LEVEL=info
LOG_FILE_ENABLED=true

# 邮件配置（生产环境）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=${SMTP_USER:-}
SMTP_PASS=${SMTP_PASS:-}
SMTP_FROM=${SMTP_FROM:-}

# 微信配置（生产环境）
WECHAT_APP_ID=${WECHAT_APP_ID:-}
WECHAT_APP_SECRET=${WECHAT_APP_SECRET:-}

# 支付配置（生产环境）
PAYMENT_SANDBOX=false
ALIPAY_APP_ID=alipay_app_id
ALIPAY_PRIVATE_KEY=alipay_private_key

# 缓存配置
CACHE_TTL=3600
CACHE_MAX_KEYS=10000

# 安全配置
CORS_ORIGIN=http://luhe.site,https://luhe.site,http://150.158.167.240
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# SSL配置
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 监控配置
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# 前端环境变量配置
VITE_API_BASE_URL=http://luhe.site/api/v1
VITE_APP_TITLE=婚礼主持人平台
VITE_ENVIRONMENT=production
VITE_NODE_ENV=prod

# 文件上传配置
DIRECT_UPLOAD_OSS=true
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg,video/quicktime,video/x-msvideo,video/x-ms-wmv,video/x-flv