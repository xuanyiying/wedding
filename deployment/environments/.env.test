# 环境标识
NODE_ENV=test
ENVIRONMENT=test
DEPLOY_ENV=testing

# 服务器配置
SERVER_HOST=localhost
SERVER_PORT=3002
WEB_PORT=8080
API_BASE_URL=http://localhost:3002

# 数据库配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=wedding_db_test
MYSQL_USER=wedding_test
MYSQL_PASSWORD=test_password_2025
MYSQL_ROOT_PASSWORD=root_test_2025

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_test_2025

# MinIO配置
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=test_minio_access
MINIO_SECRET_KEY=test_minio_secret_2025
MINIO_BUCKET=wedding-test
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# 安全配置
JWT_SECRET=test_jwt_secret_key_2025_wedding
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:8080

# 邮件配置 (测试环境使用Mock)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test@wedding-test.local
SMTP_PASS=test_password
SMTP_FROM="Wedding Test <noreply@wedding-test.local>"

# 文件上传配置
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif

# 日志配置
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true

# 测试配置
TEST_MODE=true
MOCK_EXTERNAL_APIS=true
TEST_TIMEOUT=30000

# Docker网络配置
DOCKER_NETWORK=wedding-test-network
DOCKER_SUBNET=172.26.0.0/16

# API配置
API_TIMEOUT=15000
API_RATE_LIMIT=500

# MinIO API配置
OSS_TYPE=minio
OSS_ENDPOINT=http://minio:9000
OSS_ACCESS_KEY=test_minio_access
OSS_SECRET_KEY=test_minio_secret_2025
OSS_BUCKET=wedding-test

# Vite配置
VITE_API_URL=http://localhost:3002
VITE_UPLOAD_URL=http://localhost:3002/upload
VITE_MINIO_URL=http://localhost:9000
VITE_APP_TITLE="Wedding Client Test"
VITE_APP_VERSION=1.0.0-test

# 会话配置
SESSION_SECRET=test_session_secret_2025
SESSION_MAX_AGE=3600000

# 缓存配置
CACHE_TTL=60
CACHE_MAX_SIZE=50
CACHE_ENABLED=true

DIRECT_UPLOAD_OSS=false

# 文件上传配置
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg
VITE_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document 

