# =============================================================================
# Wedding Club - 测试环境配置
# =============================================================================

# 环境标识
ENVIRONMENT=test
NODE_ENV=test

# 域名和端口配置
DOMAIN=localhost:8080
WEB_PORT=8080
SERVER_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# OSS存储配置（统一使用OSS_前缀）
OSS_TYPE=minio
OSS_ENDPOINT=http://wedding-minio-test:9000
OSS_PUBLIC_ENDPOINT=http://localhost:9001
OSS_ACCESS_KEY=test_minio_admin
OSS_SECRET_KEY=test_minio_password_456
OSS_BUCKET=wedding-service
OSS_REGION=us-east-1
OSS_USE_SSL=false
OSS_PATH_STYLE=true

# MinIO服务配置（Docker Compose使用）
MINIO_ROOT_USER=test_minio_admin
MINIO_ROOT_PASSWORD=test_minio_password_456

# 数据库配置（统一使用DB_前缀）
DB_HOST=wedding-service-mysql-test
DB_PORT=3306
DB_NAME=wedding_service_test
DB_USER=wedding_service_test
DB_PASSWORD=test_password_456
DB_USERNAME=wedding_service_test

# MySQL服务配置（Docker Compose使用）
MYSQL_ROOT_PASSWORD=test_root_password_456
MYSQL_DATABASE=wedding_service_test
MYSQL_USER=wedding_service_test
MYSQL_PASSWORD=test_password_456

# Redis配置
REDIS_HOST=wedding-redis-test
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=test_redis_password_456

# JWT配置
JWT_SECRET=test_jwt_secret_key_for_testing_environment
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key_for_testing_environment
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 服务器配置
HOST=0.0.0.0
PORT=3000
API_HOST=localhost

# 文件上传配置
UPLOAD_MAX_SIZE=100MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,mp4,mov,avi,pdf

# 日志配置
LOG_LEVEL=info
LOG_FILE_ENABLED=true

# 邮件配置（测试环境）
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_smtp_user
SMTP_PASS=test_smtp_password
SMTP_FROM=noreply@wedding-test.local

# 微信配置（测试环境）
WECHAT_APP_ID=test_wechat_app_id
WECHAT_APP_SECRET=test_wechat_app_secret

# 支付配置（测试环境使用沙箱）
PAYMENT_SANDBOX=true
ALIPAY_APP_ID=test_alipay_app_id
ALIPAY_PRIVATE_KEY=test_alipay_private_key

# 缓存配置
CACHE_TTL=600
CACHE_MAX_KEYS=5000

# 安全配置
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=500

# 监控配置
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# 前端环境变量配置
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE="婚礼主持人平台 - 测试环境"
VITE_ENVIRONMENT=test
VITE_NODE_ENV=test

# 文件上传配置
DIRECT_UPLOAD_OSS=false
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg,video/quicktime,video/x-msvideo,video/x-ms-wmv,video/x-flv