# =============================================================================
# Wedding Club - 开发环境配置
# =============================================================================

# 环境标识
ENVIRONMENT=dev
NODE_ENV=dev

# 域名和端口配置
DOMAIN=localhost
WEB_PORT=8080
WEB_INTERNAL_PORT=8081
SERVER_PORT=3000
SERVER_INTERNAL_PORT=3000
NGINX_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# OSS存储配置（统一使用OSS_前缀）
OSS_TYPE=tencent
OSS_REGION=ap-beijing
OSS_ENDPOINT=https://luhe-medias-1393897272.cos.ap-beijing.myqcloud.com
OSS_PUBLIC_ENDPOINT=https://luhe-medias-1393897272.cos.ap-beijing.myqcloud.com
OSS_ACCESS_KEY=your_tencent_oss_access_key
OSS_SECRET_KEY=your_tencent_oss_secret_key
OSS_BUCKET=luhe-medias-1393897272
OSS_USE_SSL=true

# 数据库配置（统一使用DB_前缀）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wedding_service
DB_USER=wedding_service
DB_PASSWORD=password_123
DB_USERNAME=wedding_service

# MySQL服务配置（Docker Compose使用）
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=wedding_service
MYSQL_USER=wedding_service
MYSQL_PASSWORD=password_123

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password_123

# JWT配置
JWT_SECRET=2025@Wedding
JWT_REFRESH_SECRET=2025@WeddingRefresh
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 服务器配置
HOST=0.0.0.0
PORT=3000
API_HOST=localhost

# 文件上传配置
UPLOAD_MAX_SIZE=50MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,mp4,mov,avi

# 日志配置
LOG_FILE=/server/logs/app.log
LOG_ERROR_FILE=/server/logs/error.log
LOG_LEVEL=info
LOG_FILE_ENABLED=true

# 邮件配置（开发环境使用测试配置）
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test@ethereal.email
SMTP_PASS=test_password
SMTP_FROM=noreply@wedding.club

# 缓存配置
CACHE_TTL=300
CACHE_MAX_KEYS=1000

# 安全配置
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000
API_PREFIX=/api/v1

# 监控配置
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# 前端环境变量配置
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_TITLE="婚礼主持人平台 - 开发环境"
VITE_ENVIRONMENT=development
VITE_NODE_ENV=dev

# 文件上传配置
DIRECT_UPLOAD_OSS=false
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg,video/quicktime,video/x-msvideo,video/x-ms-wmv,video/x-flv